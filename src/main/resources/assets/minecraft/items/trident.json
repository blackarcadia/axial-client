      },
      {
        "threshold": 257,
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/custom_model_data_257"
        }
      },
      {
        "threshold": 273,
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/custom_model_data_273"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "cases": [
        {
          "model": {
