{
  "model": {
    "type": "minecraft:range_dispatch",
    "property": "minecraft:custom_model_data",
    "entries": [
      {
        "threshold": 232,
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/custom_model_data_232"
        }
      },
      {
        "threshold": 245,
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/kryosword"
        }
      },
      {
        "threshold": 257,
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/custom_model_data_257"
        }
      }
    ],
    "fallback": {
